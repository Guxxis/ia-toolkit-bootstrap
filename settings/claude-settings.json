{
  "model": "sonnet",
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "2147483647"
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "theme": "dark-ansi",
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "rtk hook claude" }]
      }
    ]
  }
}
