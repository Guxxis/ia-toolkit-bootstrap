{
  "_comment": "obsidian e jira ficam registrados por projeto (claude.json .projects['<dir>'].mcpServers); context7 é global (claude.json .mcpServers) — ver docs/CURRENT-SETUP.md secao 1",
  "mcpServers": {
    "obsidian": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@blacksmithers/obsidian-forge-mcp", "{{OBSIDIAN_VAULT_PATH}}"]
    },
    "jira": {
      "type": "stdio",
      "command": "{{HOME}}/.local/bin/mcp-atlassian",
      "args": [
        "--jira-url", "{{JIRA_URL}}",
        "--jira-username", "{{JIRA_USERNAME}}",
        "--jira-token", "{{JIRA_API_TOKEN}}"
      ],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{{CONTEXT7_API_KEY}}"
      }
    }
  }
}
